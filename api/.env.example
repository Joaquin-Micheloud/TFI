# Copiá este archivo como .env y completá los valores. El .env nunca se sube al repositorio.

# Base de datos (Docker local: docker compose up -d, puerto 5433)
DATABASE_URL="postgresql://quilatear:quilatear@localhost:5433/quilatear"
# En Azure: postgresql://USUARIO:CLAVE@SERVIDOR.postgres.database.azure.com:5432/quilatear?sslmode=require

# Autenticación: una clave larga y aleatoria. Generala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambiame-por-una-clave-larga-y-aleatoria"
# Duración del token en segundos (86400 = 24 horas)
JWT_EXPIRES_IN=86400

# Frontend: origen permitido por CORS y base de los links de las invitaciones
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# Puerto de la API (en Azure App Service lo define la plataforma)
PORT=3000

# Cada cuántos minutos se leen las cotizaciones
COTIZACIONES_DOLAR_MINUTOS=30
COTIZACIONES_METALES_MINUTOS=30

# Email. En desarrollo, Mailpit (http://localhost:8025) no necesita usuario.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="QuilateAr <no-responder@quilatear.local>"

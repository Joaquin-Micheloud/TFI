generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Rol {
  ADMIN
  GERENTE
  VENDEDOR
}

enum ProveedorAuth {
  EMAIL
  GOOGLE
}

enum TipoDolar {
  OFICIAL
  BLUE
  MEP
  CCL
  TARJETA
  MAYORISTA
}

enum TipoCotizacion {
  DOLAR_OFICIAL
  DOLAR_BLUE
  DOLAR_MEP
  DOLAR_CCL
  DOLAR_TARJETA
  DOLAR_MAYORISTA
  ORO
  PLATA
}

enum Metal {
  ORO
  PLATA
}

enum ModoPrecioMetal {
  AUTOMATICO
  AJUSTE
  MANUAL
}

enum TipoProducto {
  REVENTA
  FANTASIA
  ELABORACION
}

enum ModoStock {
  UNICO
  LOTE
}

enum Moneda {
  ARS
  USD
}

enum ElaboracionPor {
  PIEZA
  GRAMO
}

enum EstadoPieza {
  DISPONIBLE
  RESERVADA
  VENDIDA
  EN_TRANSITO
  BAJA
}

enum TipoMovimiento {
  INGRESO_COMPRA
  INGRESO_ELABORACION
  VENTA
  DEVOLUCION
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
  AJUSTE_INVENTARIO
  BAJA
}

enum MotivoBaja {
  ROTURA
  PERDIDA
  FUNDICION
  OTRO
}

enum EstadoInvitacion {
  PENDIENTE
  ACEPTADA
  CANCELADA
}

enum EstadoVenta {
  CONFIRMADA
  ANULADA
}

enum MedioPago {
  EFECTIVO_ARS
  EFECTIVO_USD
  TRANSFERENCIA
  DEBITO
  CREDITO
}

enum DestinoDevolucion {
  STOCK // vuelve a estar disponible
  BAJA  // vino dañado: se da de baja
}

enum EstadoTransferencia {
  ENVIADA
  RECIBIDA
  CANCELADA
}

enum EstadoCompostura {
  RECIBIDA      // la pieza entró al local
  PRESUPUESTADA // esperando que el cliente acepte el presupuesto
  EN_TALLER
  LISTA
  ENTREGADA
  CANCELADA
}

enum TipoVenta {
  PRODUCTOS
  SERVICIO // entrega de una compostura
}
// ---------- Organización ----------

model Negocio {
  id                     String    @id @default(uuid()) @db.Uuid
  nombre                 String
  cuit                   String?
  tipoDolar              TipoDolar @default(BLUE) @map("tipo_dolar")
  plan                   String?
  respuestasCuestionario Json?     @map("respuestas_cuestionario")
  reglaRedondeo          Int       @default(100) @map("regla_redondeo")
  ultimoNumeroCompostura Int       @default(0) @map("ultimo_numero_compostura")
  creadoEn               DateTime  @default(now()) @map("creado_en")
  actualizadoEn          DateTime  @updatedAt @map("actualizado_en")

  tiendas    Tienda[]
  membresias Membresia[]
  configPreciosMetal   ConfigPrecioMetal[]
  preciosManualesGramo PrecioManualGramo[]
  categorias Categoria[]
  productos  Producto[]
  piezas           Pieza[]
  lotes            Lote[]
  movimientosStock MovimientoStock[]
  invitaciones Invitacion[]
  ventas       Venta[]
  devoluciones Devolucion[]
  clientes     Cliente[]
  transferencias Transferencia[]
  composturas    Compostura[]

  @@map("negocios")
}

model Usuario {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique
  nombre        String?
  proveedorAuth ProveedorAuth @map("proveedor_auth")
  passwordHash  String?       @map("password_hash")
  googleId      String?       @unique @map("google_id")
  verificado    Boolean       @default(false)
  creadoEn      DateTime      @default(now()) @map("creado_en")
  actualizadoEn DateTime      @updatedAt @map("actualizado_en")

  membresias Membresia[]
  preciosManualesCargados PrecioManualGramo[]
  movimientosStock MovimientoStock[]
  invitacionesEnviadas Invitacion[]
  ventas               Venta[]      @relation("VentasRealizadas")
  ventasAnuladas       Venta[]      @relation("VentasAnuladas")
  devoluciones         Devolucion[]
  transferenciasEnviadas   Transferencia[] @relation("TransferenciaEnviadaPor")
  transferenciasRecibidas  Transferencia[] @relation("TransferenciaRecibidaPor")
  transferenciasCanceladas Transferencia[] @relation("TransferenciaCanceladaPor")
  composturasRecibidas     Compostura[]       @relation("ComposturasRecibidas")
  cambiosCompostura        ComposturaEstado[]


  @@map("usuarios")
}

model Membresia {
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  negocioId     String   @map("negocio_id") @db.Uuid
  rol           Rol
  topeDescuento Decimal  @default(0) @map("tope_descuento") @db.Decimal(5, 2)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")

  usuario Usuario         @relation(fields: [usuarioId], references: [id])
  negocio Negocio         @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  tiendas UsuarioTienda[]

  @@unique([usuarioId, negocioId])
  @@index([negocioId])
  @@map("membresias")
}

model Tienda {
  id            String   @id @default(uuid()) @db.Uuid
  negocioId     String   @map("negocio_id") @db.Uuid
  nombre        String
  direccion     String?
  localidad     String?
  provincia     String?
  activa        Boolean  @default(true)
  puntoVenta        Int      @default(1) @map("punto_venta")
  ultimoNumeroVenta Int      @default(0) @map("ultimo_numero_venta")
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  negocio  Negocio         @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  usuarios UsuarioTienda[]
  piezas           Pieza[]
  lotes            Lote[]
  movimientosStock MovimientoStock[]
  ventas           Venta[]
  transferenciasSalida  Transferencia[] @relation("TransferenciaOrigen")
  transferenciasEntrada Transferencia[] @relation("TransferenciaDestino")
  composturas           Compostura[]

  @@unique([negocioId, nombre])
  @@index([negocioId])
  @@map("tiendas")
}

model UsuarioTienda {
  membresiaId String @map("membresia_id") @db.Uuid
  tiendaId    String @map("tienda_id") @db.Uuid

  membresia Membresia @relation(fields: [membresiaId], references: [id], onDelete: Cascade)
  tienda    Tienda    @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@id([membresiaId, tiendaId])
  @@map("usuarios_tiendas")
}

// ---------- Cotizaciones y precio del gramo ----------

model Cotizacion {
  id          String         @id @default(uuid()) @db.Uuid
  tipo        TipoCotizacion
  valorCompra Decimal?       @map("valor_compra") @db.Decimal(14, 4)
  valorVenta  Decimal        @map("valor_venta") @db.Decimal(14, 4)
  unidad      String // "ARS/USD" para dólares, "USD/oz" para metales
  fuente      String
  fechaHora   DateTime       @map("fecha_hora") // cuándo la actualizó la fuente
  creadoEn    DateTime       @default(now()) @map("creado_en") // cuándo la leímos

  @@index([tipo, creadoEn])
  @@map("cotizaciones")
}

model ConfigPrecioMetal {
  id            String          @id @default(uuid()) @db.Uuid
  negocioId     String          @map("negocio_id") @db.Uuid
  metal         Metal
  modo          ModoPrecioMetal @default(AUTOMATICO)
  ajustePct     Decimal         @default(0) @map("ajuste_pct") @db.Decimal(6, 2)
  actualizadoEn DateTime        @updatedAt @map("actualizado_en")

  negocio Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@unique([negocioId, metal])
  @@map("config_precio_metal")
}

model PrecioManualGramo {
  id           String   @id @default(uuid()) @db.Uuid
  negocioId    String   @map("negocio_id") @db.Uuid
  metal        Metal
  ley          Decimal  @db.Decimal(4, 3)
  precioArs    Decimal  @map("precio_ars") @db.Decimal(14, 2)
  vigenteDesde DateTime @default(now()) @map("vigente_desde")
  usuarioId    String   @map("usuario_id") @db.Uuid

  negocio Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([negocioId, metal, ley, vigenteDesde])
  @@map("precios_manuales_gramo")
}

// ---------- Catálogo ----------

model Categoria {
  id               String   @id @default(uuid()) @db.Uuid
  negocioId        String   @map("negocio_id") @db.Uuid
  nombre           String
  margenDefectoPct Decimal  @default(0) @map("margen_defecto_pct") @db.Decimal(6, 2)
  creadoEn         DateTime @default(now()) @map("creado_en")
  actualizadoEn    DateTime @updatedAt @map("actualizado_en")

  negocio   Negocio    @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  productos Producto[]

  @@unique([negocioId, nombre])
  @@map("categorias")
}

model Producto {
  id           String       @id @default(uuid()) @db.Uuid
  negocioId    String       @map("negocio_id") @db.Uuid
  categoriaId  String?      @map("categoria_id") @db.Uuid
  codigo       String
  codigoBarras String?      @map("codigo_barras")
  nombre       String
  descripcion  String?
  tipo         TipoProducto
  modoStock    ModoStock    @map("modo_stock")

  // Tipos REVENTA y ELABORACION (los metales están en ProductoComponente)
  pesoGramos Decimal? @map("peso_gramos") @db.Decimal(10, 3) // peso de referencia

  // Margen propio (null = usa el de la categoría)
  margenPct Decimal? @map("margen_pct") @db.Decimal(6, 2)

  // Tipo FANTASIA
  precioCompra Decimal? @map("precio_compra") @db.Decimal(14, 2)
  monedaCompra Moneda?  @map("moneda_compra")

  // Tipo ELABORACION
  elaboracionUsd Decimal?        @map("elaboracion_usd") @db.Decimal(12, 2)
  elaboracionPor ElaboracionPor? @map("elaboracion_por")
  insumosArs     Decimal?        @map("insumos_ars") @db.Decimal(14, 2)

  stockMinimo   Int?     @map("stock_minimo")
  fotoUrl       String?  @map("foto_url")
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  negocio     Negocio              @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  categoria   Categoria?           @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  piezas      Pieza[]
  lotes       Lote[]
  movimientos MovimientoStock[]
  ventaItems  VentaItem[]
  componentes ProductoComponente[]
  transferenciaItems TransferenciaItem[]

  @@unique([negocioId, codigo])
  @@unique([negocioId, codigoBarras])
  @@index([negocioId, tipo])
  @@index([categoriaId])
  @@map("productos")
}

model ProductoComponente {
  id         String  @id @default(uuid()) @db.Uuid
  productoId String  @map("producto_id") @db.Uuid
  metal      Metal
  ley        Decimal @db.Decimal(4, 3)
  porcentaje Decimal @db.Decimal(5, 2)
  orden      Int     @default(0)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId])
  @@map("producto_componentes")
}

// ---------- Stock ----------

model Pieza {
  id           String      @id @default(uuid()) @db.Uuid
  negocioId    String      @map("negocio_id") @db.Uuid
  productoId   String      @map("producto_id") @db.Uuid
  tiendaId     String      @map("tienda_id") @db.Uuid
  codigo       String
  pesoGramos   Decimal     @map("peso_gramos") @db.Decimal(10, 3)
  precioCompra Decimal?    @map("precio_compra") @db.Decimal(14, 2) // ARS, solo reventa
  hechuraUsd   Decimal?    @map("hechura_usd") @db.Decimal(12, 2) // solo reventa
  dolarAlta    Decimal     @map("dolar_alta") @db.Decimal(14, 4)
  gramoAlta    Decimal?    @map("gramo_alta") @db.Decimal(14, 2)
  estado       EstadoPieza @default(DISPONIBLE)
  creadoEn     DateTime    @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt @map("actualizado_en")

  negocio     Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  producto    Producto          @relation(fields: [productoId], references: [id])
  tienda      Tienda            @relation(fields: [tiendaId], references: [id])
  movimientos MovimientoStock[]
  ventaItems  VentaItem[]
  transferenciaItems TransferenciaItem[]

  @@unique([negocioId, codigo])
  @@index([productoId, estado])
  @@index([tiendaId, estado])
  @@map("piezas")
}

model Lote {
  id                 String   @id @default(uuid()) @db.Uuid
  negocioId          String   @map("negocio_id") @db.Uuid
  productoId         String   @map("producto_id") @db.Uuid
  tiendaId           String   @map("tienda_id") @db.Uuid
  cantidadInicial    Int      @map("cantidad_inicial")
  cantidadDisponible Int      @map("cantidad_disponible")
  pesoTotalGramos    Decimal? @map("peso_total_gramos") @db.Decimal(12, 3)
  precioCompraTotal  Decimal? @map("precio_compra_total") @db.Decimal(14, 2)
  monedaCompra       Moneda   @default(ARS) @map("moneda_compra")
  hechuraUsdUnitaria Decimal? @map("hechura_usd_unitaria") @db.Decimal(12, 2)
  dolarAlta          Decimal  @map("dolar_alta") @db.Decimal(14, 4)
  gramoAlta          Decimal? @map("gramo_alta") @db.Decimal(14, 2)
  fechaIngreso       DateTime @default(now()) @map("fecha_ingreso")

  negocio     Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  producto    Producto          @relation(fields: [productoId], references: [id])
  tienda      Tienda            @relation(fields: [tiendaId], references: [id])
  movimientos MovimientoStock[]
  ventaItems  VentaItem[]
  transferenciasSalida  TransferenciaItem[] @relation("LoteOrigenTransferencia")
  transferenciasEntrada TransferenciaItem[] @relation("LoteDestinoTransferencia")

  @@index([productoId, tiendaId, fechaIngreso])
  @@map("lotes")
}

model MovimientoStock {
  id         String         @id @default(uuid()) @db.Uuid
  negocioId  String         @map("negocio_id") @db.Uuid
  productoId String         @map("producto_id") @db.Uuid
  tiendaId   String         @map("tienda_id") @db.Uuid
  piezaId    String?        @map("pieza_id") @db.Uuid
  loteId     String?        @map("lote_id") @db.Uuid
  usuarioId  String         @map("usuario_id") @db.Uuid
  tipo       TipoMovimiento
  cantidad   Int // positivo = entra, negativo = sale
  motivoBaja MotivoBaja?    @map("motivo_baja")
  detalle    String?
  referencia String? // id de la venta o transferencia que lo generó
  fecha      DateTime       @default(now())

  negocio  Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])
  tienda   Tienda   @relation(fields: [tiendaId], references: [id])
  pieza    Pieza?   @relation(fields: [piezaId], references: [id])
  lote     Lote?    @relation(fields: [loteId], references: [id])
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([negocioId, fecha])
  @@index([productoId])
  @@index([tiendaId])
  @@map("movimientos_stock")
}

// ---------- Invitaciones ----------

model Invitacion {
  id            String           @id @default(uuid()) @db.Uuid
  negocioId     String           @map("negocio_id") @db.Uuid
  email         String
  rol           Rol
  topeDescuento Decimal          @default(0) @map("tope_descuento") @db.Decimal(5, 2)
  tiendaIds     String[]         @map("tienda_ids") @db.Uuid
  tokenHash     String           @unique @map("token_hash")
  venceEn       DateTime         @map("vence_en")
  estado        EstadoInvitacion @default(PENDIENTE)
  invitadoPorId String           @map("invitado_por_id") @db.Uuid
  aceptadaEn    DateTime?        @map("aceptada_en")
  creadoEn      DateTime         @default(now()) @map("creado_en")

  negocio     Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  invitadoPor Usuario @relation(fields: [invitadoPorId], references: [id])

  @@index([negocioId, estado])
  @@index([email])
  @@map("invitaciones")
}

// ---------- Ventas ----------

model Venta {
  id                String      @id @default(uuid()) @db.Uuid
  negocioId         String      @map("negocio_id") @db.Uuid
  tiendaId          String      @map("tienda_id") @db.Uuid
  usuarioId         String      @map("usuario_id") @db.Uuid
  puntoVenta        Int         @map("punto_venta")
  numero            Int
  fecha             DateTime    @default(now())
  subtotal          Decimal     @db.Decimal(14, 2) // suma de precios de lista
  descuentoPct      Decimal     @default(0) @map("descuento_pct") @db.Decimal(5, 2) // descuento sobre el total
  descuentoTotal    Decimal     @map("descuento_total") @db.Decimal(14, 2) // todos los descuentos en pesos
  total             Decimal     @db.Decimal(14, 2)
  vuelto            Decimal     @default(0) @db.Decimal(14, 2)
  tipoDolar         TipoDolar   @map("tipo_dolar")
  dolarUsado        Decimal     @map("dolar_usado") @db.Decimal(14, 4)
  cotizacionDolarId String?     @map("cotizacion_dolar_id") @db.Uuid
  estado            EstadoVenta @default(CONFIRMADA)
  motivoAnulacion   String?     @map("motivo_anulacion")
  anuladaEn         DateTime?   @map("anulada_en")
  anuladaPorId      String?     @map("anulada_por_id") @db.Uuid
  clienteId         String?     @map("cliente_id") @db.Uuid
  tipo              TipoVenta   @default(PRODUCTOS)

  negocio      Negocio      @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  tienda       Tienda       @relation(fields: [tiendaId], references: [id])
  usuario      Usuario      @relation("VentasRealizadas", fields: [usuarioId], references: [id])
  anuladaPor   Usuario?     @relation("VentasAnuladas", fields: [anuladaPorId], references: [id])
  cliente      Cliente?     @relation(fields: [clienteId], references: [id])
  items        VentaItem[]
  pagos        Pago[]
  devoluciones Devolucion[]
  compostura   Compostura?

  @@unique([tiendaId, numero])
  @@index([negocioId, fecha])
  @@index([usuarioId, fecha])
  @@map("ventas")
  @@index([clienteId])
}

model VentaItem {
  id                  String   @id @default(uuid()) @db.Uuid
  ventaId             String   @map("venta_id") @db.Uuid
  orden               Int
  productoId          String?  @map("producto_id") @db.Uuid // null en el servicio de una compostura
  piezaId             String?  @map("pieza_id") @db.Uuid
  loteId              String?  @map("lote_id") @db.Uuid
  codigo              String
  descripcion         String
  cantidad            Int
  precioListaUnitario Decimal  @map("precio_lista_unitario") @db.Decimal(14, 2)
  descuentoPct        Decimal  @default(0) @map("descuento_pct") @db.Decimal(5, 2)
  subtotal            Decimal  @db.Decimal(14, 2)
  // Snapshot del cálculo
  costoUnitario       Decimal  @map("costo_unitario") @db.Decimal(14, 2)
  margenPct           Decimal  @map("margen_pct") @db.Decimal(6, 2)
  metal               Metal?
  ley                 Decimal? @db.Decimal(4, 3)
  pesoGramos          Decimal? @map("peso_gramos") @db.Decimal(10, 3)
  gramoUsado          Decimal? @map("gramo_usado") @db.Decimal(14, 2)
  cotizacionMetalId   String?  @map("cotizacion_metal_id") @db.Uuid
  componentes         Json?

  venta    Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto Producto? @relation(fields: [productoId], references: [id])
  pieza    Pieza?    @relation(fields: [piezaId], references: [id])
  lote     Lote?     @relation(fields: [loteId], references: [id])
  devolucionItems DevolucionItem[]

  @@index([ventaId])
  @@index([productoId])
  @@map("venta_items")
}

model Pago {
  id         String    @id @default(uuid()) @db.Uuid
  ventaId    String    @map("venta_id") @db.Uuid
  medio      MedioPago
  moneda     Moneda
  monto      Decimal   @db.Decimal(14, 2) // en la moneda del pago
  montoArs   Decimal   @map("monto_ars") @db.Decimal(14, 2)
  cuotas     Int?
  referencia String?

  venta Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)


  @@map("pagos")
}

// ---------- Devoluciones ----------

model Devolucion {
  id             String    @id @default(uuid()) @db.Uuid
  negocioId      String    @map("negocio_id") @db.Uuid
  ventaId        String    @map("venta_id") @db.Uuid
  usuarioId      String    @map("usuario_id") @db.Uuid
  motivo         String
  medioReintegro MedioPago @map("medio_reintegro")
  montoArs       Decimal   @map("monto_ars") @db.Decimal(14, 2) // lo que se le devuelve al cliente
  fecha          DateTime  @default(now())

  negocio Negocio          @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  venta   Venta            @relation(fields: [ventaId], references: [id])
  usuario Usuario          @relation(fields: [usuarioId], references: [id])
  items   DevolucionItem[]

  @@index([ventaId])
  @@index([negocioId, fecha])
  @@map("devoluciones")
}

model DevolucionItem {
  id           String            @id @default(uuid()) @db.Uuid
  devolucionId String            @map("devolucion_id") @db.Uuid
  ventaItemId  String            @map("venta_item_id") @db.Uuid
  cantidad     Int
  montoArs     Decimal           @map("monto_ars") @db.Decimal(14, 2)
  destino      DestinoDevolucion

  devolucion Devolucion @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  ventaItem  VentaItem  @relation(fields: [ventaItemId], references: [id])

  @@index([ventaItemId])
  @@map("devolucion_items")
}

// ---------- Clientes ----------

model Cliente {
  id            String   @id @default(uuid()) @db.Uuid
  negocioId     String   @map("negocio_id") @db.Uuid
  nombre        String
  telefono      String?
  email         String?
  dni           String? // solo números
  notas         String?
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  negocio     Negocio      @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  ventas      Venta[]
  composturas Compostura[]

  @@unique([negocioId, dni])
  @@index([negocioId, nombre])
  @@map("clientes")
}

// ---------- Transferencias entre tiendas ----------

model Transferencia {
  id             String              @id @default(uuid()) @db.Uuid
  negocioId      String              @map("negocio_id") @db.Uuid
  origenId       String              @map("origen_id") @db.Uuid
  destinoId      String              @map("destino_id") @db.Uuid
  estado         EstadoTransferencia @default(ENVIADA)
  nota           String?
  enviadaPorId   String              @map("enviada_por_id") @db.Uuid
  enviadaEn      DateTime            @default(now()) @map("enviada_en")
  recibidaPorId  String?             @map("recibida_por_id") @db.Uuid
  recibidaEn     DateTime?           @map("recibida_en")
  canceladaPorId String?             @map("cancelada_por_id") @db.Uuid
  canceladaEn    DateTime?           @map("cancelada_en")

  negocio      Negocio             @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  origen       Tienda              @relation("TransferenciaOrigen", fields: [origenId], references: [id])
  destino      Tienda              @relation("TransferenciaDestino", fields: [destinoId], references: [id])
  enviadaPor   Usuario             @relation("TransferenciaEnviadaPor", fields: [enviadaPorId], references: [id])
  recibidaPor  Usuario?            @relation("TransferenciaRecibidaPor", fields: [recibidaPorId], references: [id])
  canceladaPor Usuario?            @relation("TransferenciaCanceladaPor", fields: [canceladaPorId], references: [id])
  items        TransferenciaItem[]

  @@index([negocioId, estado])
  @@index([origenId])
  @@index([destinoId])
  @@map("transferencias")
}

model TransferenciaItem {
  id              String  @id @default(uuid()) @db.Uuid
  transferenciaId String  @map("transferencia_id") @db.Uuid
  productoId      String  @map("producto_id") @db.Uuid
  piezaId         String? @map("pieza_id") @db.Uuid
  loteOrigenId    String? @map("lote_origen_id") @db.Uuid
  loteDestinoId   String? @map("lote_destino_id") @db.Uuid // se completa al recibir
  cantidad        Int

  transferencia Transferencia @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  producto      Producto      @relation(fields: [productoId], references: [id])
  pieza         Pieza?        @relation(fields: [piezaId], references: [id])
  loteOrigen    Lote?         @relation("LoteOrigenTransferencia", fields: [loteOrigenId], references: [id])
  loteDestino   Lote?         @relation("LoteDestinoTransferencia", fields: [loteDestinoId], references: [id])

  @@index([transferenciaId])
  @@map("transferencia_items")
}

// ---------- Composturas ----------

model Compostura {
  id                String           @id @default(uuid()) @db.Uuid
  negocioId         String           @map("negocio_id") @db.Uuid
  tiendaId          String           @map("tienda_id") @db.Uuid
  clienteId         String           @map("cliente_id") @db.Uuid
  usuarioId         String           @map("usuario_id") @db.Uuid // quién la recibió
  numero            Int // correlativo por negocio: orden 000123
  estado            EstadoCompostura @default(RECIBIDA)
  descripcion       String
  metal             Metal?
  ley               Decimal?         @db.Decimal(4, 3)
  pesoEntrada       Decimal          @map("peso_entrada") @db.Decimal(10, 3)
  pesoAportado      Decimal          @default(0) @map("peso_aportado") @db.Decimal(10, 3) // material que trae el cliente
  pesoAgregado      Decimal?         @map("peso_agregado") @db.Decimal(10, 3) // metal que pone la joyería
  pesoSalida        Decimal?         @map("peso_salida") @db.Decimal(10, 3)
  manoObra          Decimal?         @map("mano_obra") @db.Decimal(14, 2)
  margenPct         Decimal?         @map("margen_pct") @db.Decimal(6, 2) // sobre el material agregado
  presupuesto       Decimal?         @db.Decimal(14, 2)
  precioFinal       Decimal?         @map("precio_final") @db.Decimal(14, 2)
  sena              Decimal          @default(0) @db.Decimal(14, 2)
  medioSena         MedioPago?       @map("medio_sena")
  fechaEstimada     DateTime?        @map("fecha_estimada") @db.Date
  observaciones     String?
  motivoCancelacion String?          @map("motivo_cancelacion")
  listaEn           DateTime?        @map("lista_en")
  entregadaEn       DateTime?        @map("entregada_en")
  ventaId           String?          @unique @map("venta_id") @db.Uuid
  creadoEn          DateTime         @default(now()) @map("creado_en")
  actualizadoEn     DateTime         @updatedAt @map("actualizado_en")

  negocio   Negocio            @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  tienda    Tienda             @relation(fields: [tiendaId], references: [id])
  cliente   Cliente            @relation(fields: [clienteId], references: [id])
  usuario   Usuario            @relation("ComposturasRecibidas", fields: [usuarioId], references: [id])
  venta     Venta?             @relation(fields: [ventaId], references: [id])
  historial ComposturaEstado[]

  @@unique([negocioId, numero])
  @@index([negocioId, estado])
  @@index([clienteId])
  @@index([tiendaId])
  @@map("composturas")
}

// Historial de estados: quién cambió qué y cuándo
model ComposturaEstado {
  id           String           @id @default(uuid()) @db.Uuid
  composturaId String           @map("compostura_id") @db.Uuid
  estado       EstadoCompostura
  usuarioId    String           @map("usuario_id") @db.Uuid
  nota         String?
  fecha        DateTime         @default(now())

  compostura Compostura @relation(fields: [composturaId], references: [id], onDelete: Cascade)
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])

  @@index([composturaId])
  @@map("compostura_estados")
}

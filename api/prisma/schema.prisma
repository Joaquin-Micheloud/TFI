generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Rol {
  ADMIN
  GERENTE
  VENDEDOR
}

enum ProveedorAuth {
  EMAIL
  GOOGLE
}

enum TipoDolar {
  OFICIAL
  BLUE
  MEP
  CCL
  TARJETA
  MAYORISTA
}

enum TipoCotizacion {
  DOLAR_OFICIAL
  DOLAR_BLUE
  DOLAR_MEP
  DOLAR_CCL
  DOLAR_TARJETA
  DOLAR_MAYORISTA
  ORO
  PLATA
}

enum Metal {
  ORO
  PLATA
}

enum ModoPrecioMetal {
  AUTOMATICO
  AJUSTE
  MANUAL
}

enum TipoProducto {
  REVENTA
  FANTASIA
  ELABORACION
}

enum ModoStock {
  UNICO
  LOTE
}

enum Moneda {
  ARS
  USD
}

enum ElaboracionPor {
  PIEZA
  GRAMO
}

enum EstadoPieza {
  DISPONIBLE
  RESERVADA
  VENDIDA
  EN_TRANSITO
  BAJA
}

enum TipoMovimiento {
  INGRESO_COMPRA
  INGRESO_ELABORACION
  VENTA
  DEVOLUCION
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
  AJUSTE_INVENTARIO
  BAJA
}

enum MotivoBaja {
  ROTURA
  PERDIDA
  FUNDICION
  OTRO
}
// ---------- Organización ----------

model Negocio {
  id                     String    @id @default(uuid()) @db.Uuid
  nombre                 String
  cuit                   String?
  tipoDolar              TipoDolar @default(BLUE) @map("tipo_dolar")
  plan                   String?
  respuestasCuestionario Json?     @map("respuestas_cuestionario")
  reglaRedondeo          Int       @default(100) @map("regla_redondeo")
  creadoEn               DateTime  @default(now()) @map("creado_en")
  actualizadoEn          DateTime  @updatedAt @map("actualizado_en")

  tiendas    Tienda[]
  membresias Membresia[]
  configPreciosMetal   ConfigPrecioMetal[]
  preciosManualesGramo PrecioManualGramo[]
  categorias Categoria[]
  productos  Producto[]
  piezas           Pieza[]
  lotes            Lote[]
  movimientosStock MovimientoStock[]

  @@map("negocios")
}

model Usuario {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique
  nombre        String?
  proveedorAuth ProveedorAuth @map("proveedor_auth")
  passwordHash  String?       @map("password_hash")
  googleId      String?       @unique @map("google_id")
  verificado    Boolean       @default(false)
  creadoEn      DateTime      @default(now()) @map("creado_en")
  actualizadoEn DateTime      @updatedAt @map("actualizado_en")

  membresias Membresia[]
  preciosManualesCargados PrecioManualGramo[]
  movimientosStock MovimientoStock[]

  @@map("usuarios")
}

model Membresia {
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  negocioId     String   @map("negocio_id") @db.Uuid
  rol           Rol
  topeDescuento Decimal  @default(0) @map("tope_descuento") @db.Decimal(5, 2)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")

  usuario Usuario         @relation(fields: [usuarioId], references: [id])
  negocio Negocio         @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  tiendas UsuarioTienda[]

  @@unique([usuarioId, negocioId])
  @@index([negocioId])
  @@map("membresias")
}

model Tienda {
  id            String   @id @default(uuid()) @db.Uuid
  negocioId     String   @map("negocio_id") @db.Uuid
  nombre        String
  direccion     String?
  localidad     String?
  provincia     String?
  activa        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  negocio  Negocio         @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  usuarios UsuarioTienda[]
  piezas           Pieza[]
  lotes            Lote[]
  movimientosStock MovimientoStock[]

  @@unique([negocioId, nombre])
  @@index([negocioId])
  @@map("tiendas")
}

model UsuarioTienda {
  membresiaId String @map("membresia_id") @db.Uuid
  tiendaId    String @map("tienda_id") @db.Uuid

  membresia Membresia @relation(fields: [membresiaId], references: [id], onDelete: Cascade)
  tienda    Tienda    @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@id([membresiaId, tiendaId])
  @@map("usuarios_tiendas")
}

// ---------- Cotizaciones y precio del gramo ----------

model Cotizacion {
  id          String         @id @default(uuid()) @db.Uuid
  tipo        TipoCotizacion
  valorCompra Decimal?       @map("valor_compra") @db.Decimal(14, 4)
  valorVenta  Decimal        @map("valor_venta") @db.Decimal(14, 4)
  unidad      String // "ARS/USD" para dólares, "USD/oz" para metales
  fuente      String
  fechaHora   DateTime       @map("fecha_hora") // cuándo la actualizó la fuente
  creadoEn    DateTime       @default(now()) @map("creado_en") // cuándo la leímos

  @@index([tipo, creadoEn])
  @@map("cotizaciones")
}

model ConfigPrecioMetal {
  id            String          @id @default(uuid()) @db.Uuid
  negocioId     String          @map("negocio_id") @db.Uuid
  metal         Metal
  modo          ModoPrecioMetal @default(AUTOMATICO)
  ajustePct     Decimal         @default(0) @map("ajuste_pct") @db.Decimal(6, 2)
  actualizadoEn DateTime        @updatedAt @map("actualizado_en")

  negocio Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@unique([negocioId, metal])
  @@map("config_precio_metal")
}

model PrecioManualGramo {
  id           String   @id @default(uuid()) @db.Uuid
  negocioId    String   @map("negocio_id") @db.Uuid
  metal        Metal
  ley          Decimal  @db.Decimal(4, 3)
  precioArs    Decimal  @map("precio_ars") @db.Decimal(14, 2)
  vigenteDesde DateTime @default(now()) @map("vigente_desde")
  usuarioId    String   @map("usuario_id") @db.Uuid

  negocio Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([negocioId, metal, ley, vigenteDesde])
  @@map("precios_manuales_gramo")
}

// ---------- Catálogo ----------

model Categoria {
  id               String   @id @default(uuid()) @db.Uuid
  negocioId        String   @map("negocio_id") @db.Uuid
  nombre           String
  margenDefectoPct Decimal  @default(0) @map("margen_defecto_pct") @db.Decimal(6, 2)
  creadoEn         DateTime @default(now()) @map("creado_en")
  actualizadoEn    DateTime @updatedAt @map("actualizado_en")

  negocio   Negocio    @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  productos Producto[]

  @@unique([negocioId, nombre])
  @@map("categorias")
}

model Producto {
  id           String       @id @default(uuid()) @db.Uuid
  negocioId    String       @map("negocio_id") @db.Uuid
  categoriaId  String?      @map("categoria_id") @db.Uuid
  codigo       String
  codigoBarras String?      @map("codigo_barras")
  nombre       String
  descripcion  String?
  tipo         TipoProducto
  modoStock    ModoStock    @map("modo_stock")

  // Tipos REVENTA y ELABORACION
  metal      Metal?
  ley        Decimal? @db.Decimal(4, 3)
  pesoGramos Decimal? @map("peso_gramos") @db.Decimal(10, 3) // peso de referencia

  // Margen propio (null = usa el de la categoría)
  margenPct Decimal? @map("margen_pct") @db.Decimal(6, 2)

  // Tipo FANTASIA
  precioCompra Decimal? @map("precio_compra") @db.Decimal(14, 2)
  monedaCompra Moneda?  @map("moneda_compra")

  // Tipo ELABORACION
  elaboracionUsd Decimal?        @map("elaboracion_usd") @db.Decimal(12, 2)
  elaboracionPor ElaboracionPor? @map("elaboracion_por")
  insumosArs     Decimal?        @map("insumos_ars") @db.Decimal(14, 2)

  stockMinimo   Int?     @map("stock_minimo")
  fotoUrl       String?  @map("foto_url")
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  negocio   Negocio    @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  categoria Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  piezas      Pieza[]
  lotes       Lote[]
  movimientos MovimientoStock[]

  @@unique([negocioId, codigo])
  @@unique([negocioId, codigoBarras])
  @@index([negocioId, tipo])
  @@index([categoriaId])
  @@map("productos")
}

// ---------- Stock ----------

model Pieza {
  id           String      @id @default(uuid()) @db.Uuid
  negocioId    String      @map("negocio_id") @db.Uuid
  productoId   String      @map("producto_id") @db.Uuid
  tiendaId     String      @map("tienda_id") @db.Uuid
  codigo       String
  pesoGramos   Decimal     @map("peso_gramos") @db.Decimal(10, 3)
  precioCompra Decimal?    @map("precio_compra") @db.Decimal(14, 2) // ARS, solo reventa
  hechuraUsd   Decimal?    @map("hechura_usd") @db.Decimal(12, 2) // solo reventa
  dolarAlta    Decimal     @map("dolar_alta") @db.Decimal(14, 4)
  gramoAlta    Decimal?    @map("gramo_alta") @db.Decimal(14, 2)
  estado       EstadoPieza @default(DISPONIBLE)
  creadoEn     DateTime    @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt @map("actualizado_en")

  negocio     Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  producto    Producto          @relation(fields: [productoId], references: [id])
  tienda      Tienda            @relation(fields: [tiendaId], references: [id])
  movimientos MovimientoStock[]

  @@unique([negocioId, codigo])
  @@index([productoId, estado])
  @@index([tiendaId, estado])
  @@map("piezas")
}

model Lote {
  id                 String   @id @default(uuid()) @db.Uuid
  negocioId          String   @map("negocio_id") @db.Uuid
  productoId         String   @map("producto_id") @db.Uuid
  tiendaId           String   @map("tienda_id") @db.Uuid
  cantidadInicial    Int      @map("cantidad_inicial")
  cantidadDisponible Int      @map("cantidad_disponible")
  pesoTotalGramos    Decimal? @map("peso_total_gramos") @db.Decimal(12, 3)
  precioCompraTotal  Decimal? @map("precio_compra_total") @db.Decimal(14, 2)
  monedaCompra       Moneda   @default(ARS) @map("moneda_compra")
  hechuraUsdUnitaria Decimal? @map("hechura_usd_unitaria") @db.Decimal(12, 2)
  dolarAlta          Decimal  @map("dolar_alta") @db.Decimal(14, 4)
  gramoAlta          Decimal? @map("gramo_alta") @db.Decimal(14, 2)
  fechaIngreso       DateTime @default(now()) @map("fecha_ingreso")

  negocio     Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  producto    Producto          @relation(fields: [productoId], references: [id])
  tienda      Tienda            @relation(fields: [tiendaId], references: [id])
  movimientos MovimientoStock[]

  @@index([productoId, tiendaId, fechaIngreso])
  @@map("lotes")
}

model MovimientoStock {
  id         String         @id @default(uuid()) @db.Uuid
  negocioId  String         @map("negocio_id") @db.Uuid
  productoId String         @map("producto_id") @db.Uuid
  tiendaId   String         @map("tienda_id") @db.Uuid
  piezaId    String?        @map("pieza_id") @db.Uuid
  loteId     String?        @map("lote_id") @db.Uuid
  usuarioId  String         @map("usuario_id") @db.Uuid
  tipo       TipoMovimiento
  cantidad   Int // positivo = entra, negativo = sale
  motivoBaja MotivoBaja?    @map("motivo_baja")
  detalle    String?
  referencia String? // id de la venta o transferencia que lo generó
  fecha      DateTime       @default(now())

  negocio  Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])
  tienda   Tienda   @relation(fields: [tiendaId], references: [id])
  pieza    Pieza?   @relation(fields: [piezaId], references: [id])
  lote     Lote?    @relation(fields: [loteId], references: [id])
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([negocioId, fecha])
  @@index([productoId])
  @@index([tiendaId])
  @@map("movimientos_stock")
}